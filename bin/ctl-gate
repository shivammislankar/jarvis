#!/usr/bin/env python3
"""Forced command for the Jarvis server's SSH key on this laptop.

The server's key is installed in ~/.ssh/authorized_keys as
    restrict,command="/home/<you>/jarvis/bin/ctl-gate" ssh-ed25519 …
so whatever the server asks to run, only `ctl <args>` is executed — never a
shell. ctl itself only accepts its fixed action list.
"""
import os, shlex, sys

CTL = os.path.join(os.path.dirname(os.path.realpath(__file__)), "ctl")
import base64, json
req = os.environ.get("SSH_ORIGINAL_COMMAND", "")
try:
    if req.startswith("b64json "):          # from bin/ctl-server: exact argument list, no quoting games
        args = json.loads(base64.b64decode(req[8:], validate=True))
        if not (isinstance(args, list) and all(isinstance(a, str) for a in args)):
            raise ValueError("not a list of strings")
    else:                                    # plain words, e.g. bin/health's "battery"
        args = shlex.split(req)
except (ValueError, json.JSONDecodeError) as e:
    sys.exit(f"ctl-gate: bad request ({e})")
os.execv(CTL, [CTL] + args)        # argv list: no shell, so no injection
