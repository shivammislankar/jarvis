[Unit]
Description=Jarvis: keep a reverse SSH tunnel open to the Oracle server (server port 2222 -> laptop sshd)
After=network-online.target
Wants=network-online.target

[Service]
# -R binds 127.0.0.1:2222 on the server only (GatewayPorts no), so it is not exposed to the internet.
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=20 -o ServerAliveCountMax=3 \
  -R 127.0.0.1:2222:127.0.0.1:22 oracle
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
